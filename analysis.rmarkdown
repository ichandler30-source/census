---
title: "Analyzing US Census Data"
author: "Isabella Chandler"
execute:
  echo: false
---

```{r}
#| message: false
library(tidyverse)
library(tidycensus)
library(sf)
```

```{r}
#| message: false
#| cache: true
income_tx <- get_acs(
  geography = "county",
  variables = "B19013_001",
  state = "TX",
  year = 2020,
  geometry = TRUE
)
```

```{r}
#| message: false
edu_state <- get_acs(
  geography = "state",
  variables = c("B15003_001", "B15003_022", "B15003_023", "B15003_024", "B15003_025"),
  summary_var = "B15003_001",
  year = 2020
)
```

```{r}
#| message: false
age_ca <- get_acs(
  geography = "county",
  variables = c(median_age = "B01002_001", population = "B01003_001"),
  state = "CA",
  year = 2020,
  geometry = FALSE
)
```

```{r}
age_ca_plot <- age_ca |>
  select(NAME, variable, estimate) |>
  pivot_wider(names_from = variable, values_from = estimate)

largest_counties <- age_ca_plot |>
  slice_max(population, n = 5) |>
  arrange(desc(population)) |>
  mutate(
    label_x = population * c(1.05, 1.35, 0.75, 1.5, 0.7),
    label_y = median_age + c(1.2, -1.2, 1.2, -1.2, 1.2),
    label = str_remove(NAME, " County")
  )

ggplot(age_ca_plot, aes(x = population, y = median_age)) +
  geom_point(alpha = 0.7, color = "steelblue") +
  scale_x_log10(labels = scales::label_comma()) +
  geom_segment(
    data = largest_counties,
    aes(xend = label_x, yend = label_y),
    color = "gray50",
    linewidth = 0.4
  ) +
  geom_text(
    data = largest_counties,
    aes(x = label_x, y = label_y, label = label),
    size = 3.5
  ) +
  labs(
    title = "Population and Median Age by County",
    subtitle = "California counties, 2020",
    x = "County population (log scale)",
    y = "Median age (years)",
    caption = "Source: U.S. Census Bureau, 2020 ACS 5-year estimates."
  ) +
  theme_minimal()
```

```{r}
#| fig-height: 14
edu_state <- edu_state |>
  filter(variable %in% c("B15003_022", "B15003_023", "B15003_024", "B15003_025")) |>
  group_by(GEOID, NAME) |>
  summarize(
    percent_bachelors_and_higher = 100 * sum(estimate) / first(summary_est),
    .groups = "drop"
  ) |>
  arrange(desc(percent_bachelors_and_higher))

ggplot(edu_state, aes(
  x = reorder(NAME, percent_bachelors_and_higher),
  y = percent_bachelors_and_higher
)) +
  geom_col(fill = "steelblue") +
  coord_flip() +
  scale_y_continuous(
    labels = scales::label_percent(scale = 1),
    expand = expansion(mult = c(0, 0.05))
  ) +
  labs(
    title = "Bachelor's Degree or Higher by State",
    subtitle = "Share of population age 25 and older, 2020",
    x = NULL,
    y = "Population age 25+ with a bachelor's or higher",
    caption = "Source: U.S. Census Bureau, 2020 ACS 5-year estimates."
  ) +
  theme_minimal() +
  theme(
    plot.title = element_text(face = "bold"),
    plot.caption = element_text(hjust = 0),
    panel.grid.major.y = element_blank(),
    panel.grid.minor = element_blank()
  )
```

```{r}
ggplot(income_tx) +
  geom_sf(aes(fill = estimate), color = "white", linewidth = 0.1) +
  scale_fill_viridis_c(
    option = "viridis",
    labels = scales::label_dollar(),
    name = "Median household income"
  ) +
  labs(
    title = "Median Household Income by County",
    subtitle = "Texas, 2020",
    caption = "Source: U.S. Census Bureau, 2020 ACS 5-year estimates."
  ) +
  theme_void() +
  theme(
    plot.title = element_text(face = "bold"),
    plot.caption = element_text(hjust = 0),
    legend.position = "right"
  )
```

